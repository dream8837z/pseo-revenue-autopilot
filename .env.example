# === 사이트 기본 설정 ===
SITE_NAME=핀툴랩(FinToolLab) - 금융·부동산·세금·웹도구 올인원 허브
SITE_URL=https://example.com
SITE_DESCRIPTION=6대 공공데이터 실시간 연동 예적금·대출·실거래가·청약·세금·보조금24 및 무료 웹 유틸리티 505종 올인원 허브
CONTACT_EMAIL=contact@example.com

# === 공공데이터 무료 오픈 API 키 (미입력 시 내장 시드 데이터로 자동 Fallback) ===
# 금융감독원 금융상품한눈에 (https://finlife.fss.or.kr)
FINLIFE_API_KEY=
# 공공데이터포털 보조금24 (https://www.data.go.kr - 행정안전부 대한민국 공공서비스 정보)
DATA_GO_KR_API_KEY=

# === 수익화 설정 (애드센스 & 제휴/CPA) ===
# Google AdSense Publisher ID (예: ca-pub-1234567890123456)
ADSENSE_CLIENT_ID=
# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=

# 문맥별 제휴(CPA/어필리에이트) 링크 (미입력 시 기본 안내 링크 사용)
AFFILIATE_DEPOSIT_URL=https://example.com/go/deposit-compare
AFFILIATE_LOAN_URL=https://example.com/go/loan-compare
AFFILIATE_SUBSIDY_URL=https://example.com/go/subsidy-check

# === 자동 색인 (IndexNow - 네이버/빙/야후 등 즉시 색인 요청) ===
INDEXNOW_KEY=
ENABLE_INDEXNOW=false

# === 빌드 경로 ===
DATA_DIR=data
DIST_DIR=dist
DRY_RUN=true
